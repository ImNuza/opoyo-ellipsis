FROM python:3.12-slim-bookworm

WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src:/app/src/ml \
    OPOYO_ROOT=/app \
    TF_CPP_MIN_LOG_LEVEL=2

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        libgomp1 \
        libgfortran5 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt

COPY config.yaml /app/config.yaml
COPY src/shared /app/src/shared
COPY src/edge /app/src/edge
COPY src/ml/models /app/src/ml/models

EXPOSE 8000
EXPOSE 9000/udp
EXPOSE 9001/udp

HEALTHCHECK --interval=20s --timeout=8s --start-period=90s --retries=8 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/api/state')"

CMD ["python", "-m", "uvicorn", "edge.app:app", "--host", "0.0.0.0", "--port", "8000"]
